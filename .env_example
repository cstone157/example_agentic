# Local LLM client configuration
# Copy this file to .env and adjust values for your environment.

# Base URL of the local model serving endpoint
#   Ollama:    http://localhost:11434/v1
#   vLLM:      http://<dgx-host>:8000/v1
#   TGI:       http://<dgx-host>:8080/v1
LLM_BASE_URL=http://localhost:11434/v1

# Model name registered on the serving endpoint
LLM_MODEL_NAME=qwen3.6:35b-a3b-bf16

# API key (Ollama accepts any string; leave as-is for local use)
LLM_API_KEY=ollama
